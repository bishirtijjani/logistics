{
  "expo": {
    "name": "Logistics Platform Rider",
    "slug": "logistics-rider",
    "owner": "mh-prime",
    "scheme": "logistics",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EA580C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.logistics.rider",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Logistics Platform Rider needs your location to deliver jobs near you.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Logistics Platform Rider keeps your location active in the background so you keep receiving jobs when the app is minimised or the screen is off.",
        "UIBackgroundModes": ["location", "fetch"],
        "NSCameraUsageDescription": "Logistics Platform Rider needs the camera to capture proof of delivery and identity documents.",
        "NSPhotoLibraryUsageDescription": "Logistics Platform Rider needs photo access so you can attach KYC documents and proof-of-delivery images.",
        "NSPhotoLibraryAddUsageDescription": "Optionally save proof-of-delivery photos to your gallery.",
        "NSFaceIDUsageDescription": "Use Face ID to unlock the app and confirm sensitive actions.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": "YOUR_GOOGLE_MAPS_API_KEY"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EA580C"
      },
      "package": "ng.logistics.rider",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Logistics Platform Rider needs your location to deliver jobs near you.",
          "locationAlwaysAndWhenInUsePermission": "Logistics Platform Rider keeps your location active in the background so you keep receiving jobs when the app is minimised or the screen is off.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "androidForegroundServiceNotificationTitle": "Logistics Platform Rider is online",
          "androidForegroundServiceNotificationBody": "Receiving jobs near you - keep this running while you work.",
          "androidForegroundServiceNotificationColor": "#EA580C"
        }
      ],
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Logistics Platform Rider needs the camera to capture proof of delivery and identity documents."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#EA580C"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "mh-prime",
          "project": "logistics-rider",
          "url": "https://sentry.io/"
        }
      ],
      "expo-font",
      "@sentry/react-native"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "4e4084bc-a546-427a-8ff3-f877c33e7b26"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/4e4084bc-a546-427a-8ff3-f877c33e7b26"
    }
  }
}
