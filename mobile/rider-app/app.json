{
  "expo": {
    "name": "iPrime Rider",
    "slug": "vtu-rider-app",
    "owner": "vtu-logistics",
    "scheme": "riderapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codeket.logistics.rider",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "iPrime Rider needs your location to deliver jobs near you.",
        "NSCameraUsageDescription": "iPrime Rider needs the camera to capture proof of delivery and identity documents.",
        "NSPhotoLibraryAddUsageDescription": "Optionally save proof-of-delivery photos to your gallery.",
        "NSFaceIDUsageDescription": "Use Face ID to unlock the app and confirm sensitive actions."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyBG66pGzjm27QdEBPG84XdGHpki1nvYjbI"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EA580C"
      },
      "package": "com.codeket.logistics.rider",
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBG66pGzjm27QdEBPG84XdGHpki1nvYjbI"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "iPrime Rider needs your location to deliver jobs near you."
        }
      ],
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "iPrime Rider needs the camera to capture proof of delivery and identity documents."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Optionally save proof-of-delivery photos to your gallery.",
          "savePhotosPermission": "Optionally save proof-of-delivery photos to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#EA580C"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": ""
    }
  }
}
