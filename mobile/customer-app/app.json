{
  "expo": {
    "name": "iPrime",
    "slug": "iprime-customer",
    "owner": "mh-prime",
    "scheme": "iprime",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EA580C"
    },
    "ios": {
      "bundleIdentifier": "ng.iprime.customer",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "iPrime needs your location to show nearby services and delivery options.",
        "NSCameraUsageDescription": "iPrime needs the camera to capture your profile photo and prescription images.",
        "NSPhotoLibraryUsageDescription": "iPrime needs photo access so you can attach prescriptions, support tickets, and your profile photo.",
        "NSPhotoLibraryAddUsageDescription": "iPrime saves receipts and order images to your gallery when you tap save.",
        "NSFaceIDUsageDescription": "Use Face ID to unlock the app and confirm sensitive actions like withdrawals.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": "AIzaSyBG66pGzjm27QdEBPG84XdGHpki1nvYjbI"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EA580C"
      },
      "package": "ng.iprime.customer",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBG66pGzjm27QdEBPG84XdGHpki1nvYjbI"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "iPrime needs your location to show nearby services and delivery options."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "iPrime needs photo access so you can attach prescriptions, support tickets, and your profile photo.",
          "cameraPermission": "iPrime needs the camera to capture your profile photo and prescription images."
        }
      ],
      "expo-localization",
      [
        "@sentry/react-native/expo",
        {
          "organization": "mh-prime",
          "project": "iprime-customer",
          "url": "https://sentry.io/"
        }
      ],
      "@sentry/react-native"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "1a521fdc-1900-40e9-8e0f-83c6595dfcb9"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/1a521fdc-1900-40e9-8e0f-83c6595dfcb9"
    }
  }
}
