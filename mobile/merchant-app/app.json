{
  "expo": {
    "name": "iPrime Merchant",
    "slug": "iprime-merchant",
    "owner": "mh-prime",
    "scheme": "iprime",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EA580C"
    },
    "ios": {
      "bundleIdentifier": "ng.iprime.merchant",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "iPrime Merchant needs your location to set your store's pickup point and show nearby delivery coverage.",
        "NSCameraUsageDescription": "iPrime Merchant needs the camera to capture product and store photos.",
        "NSPhotoLibraryUsageDescription": "iPrime Merchant needs photo access so you can attach product, store, and support images.",
        "NSFaceIDUsageDescription": "Use Face ID to unlock the app and confirm sensitive actions like withdrawals.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": "AIzaSyBG66pGzjm27QdEBPG84XdGHpki1nvYjbI"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EA580C"
      },
      "package": "ng.iprime.merchant",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBG66pGzjm27QdEBPG84XdGHpki1nvYjbI"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "iPrime Merchant needs your location to set your store's pickup point."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "iPrime Merchant needs photo access so you can attach product, store, and support images.",
          "cameraPermission": "iPrime Merchant needs the camera to capture product and store photos."
        }
      ],
      "expo-local-authentication",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#EA580C"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "mh-prime",
          "project": "iprime-merchant",
          "url": "https://sentry.io/"
        }
      ],
      "@sentry/react-native"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "2805dc56-772d-4f42-b006-e95de735f965"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/2805dc56-772d-4f42-b006-e95de735f965"
    }
  }
}
