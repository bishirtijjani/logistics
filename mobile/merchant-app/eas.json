{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.",
        "EXPO_PUBLIC_MERCHANT_WEB_URL": "https://merchant.",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "development",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "staging",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.",
        "EXPO_PUBLIC_MERCHANT_WEB_URL": "https://merchant.",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "staging",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.",
        "EXPO_PUBLIC_MERCHANT_WEB_URL": "https://merchant.",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "production",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./logistics-service-account.json",
        "track": "alpha",
        "releaseStatus": "draft"
      },
      "ios": {}
    }
  }
}
