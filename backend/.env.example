# ============================================================
# VTU & LOGISTICS PLATFORM — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ============================================================

# --- Application ---
NODE_ENV=development
PORT=3000
APP_NAME=VTU-Logistics

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/vtu_logistics?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Authentication ---
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Monnify ---
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=your-monnify-api-key
MONNIFY_SECRET_KEY=your-monnify-secret-key
MONNIFY_CONTRACT_CODE=your-contract-code
MONNIFY_WALLET_ACCOUNT_NUMBER=your-wallet-account
MONNIFY_WEBHOOK_SECRET=your-webhook-secret

# --- VTPass ---
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_USERNAME=your-vtpass-username
VTPASS_PASSWORD=your-vtpass-password

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# --- Firebase (FCM) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# --- Termii (SMS/OTP) ---
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=your-sender-id

# --- Delivery Pricing ---
DELIVERY_BASE_FARE=200
DELIVERY_PER_KM_RATE=100
DELIVERY_PLATFORM_FEE_PERCENT=10
