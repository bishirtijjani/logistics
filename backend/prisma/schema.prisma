// ============================================================
// VTU & LOGISTICS PLATFORM — PRISMA SCHEMA
// Single Source of Truth for all data models
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  CUSTOMER
  RIDER
  ADMIN
  MERCHANT  // NEW: Merchant/merchant role
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  FAILED
}

// ============================================================
// UNIFIED REQUEST ARCHITECTURE — NEW ENUMS
// ============================================================

enum RequestType {
  MERCHANT_ORDER  // Any order fulfilled by a merchant (food, grocery, pharmacy, retail, etc.)
  PACKAGE         // Pure courier — no merchant, customer is the origin
}

enum RequestStatus {
  REQUESTED         // Customer placed order
  ACCEPTED          // Merchant accepted (if applicable)
  PROCESSING        // Merchant preparing (if applicable)
  READY_FOR_PICKUP  // Ready for rider
  RIDER_ASSIGNED    // Rider matched
  RIDER_EN_ROUTE    // Rider going to pickup
  PICKED_UP         // Rider has item
  IN_TRANSIT        // Rider delivering to customer
  DELIVERED         // Rider delivered
  SETTLED           // Financial settlement complete
  CANCELLED         // Cancelled by any party
}

enum MerchantStatus {
  PENDING_APPROVAL
  APPROVED
  SUSPENDED
  REJECTED
}

enum TransactionType {
  WALLET_FUNDING
  P2P_TRANSFER_SENT
  P2P_TRANSFER_RECEIVED
  WITHDRAWAL
  DELIVERY_PAYMENT
  DELIVERY_EARNING
  UTILITY_PAYMENT
  REFUND
  ESCROW_HOLD
  ESCROW_RELEASE
  ESCROW_REFUND
  PLATFORM_EARNING
  RIDER_EARNING
  MERCHANT_EARNING
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum DeliveryStatus {
  REQUESTED
  MATCHED
  RIDER_EN_ROUTE
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  SETTLED
  CANCELLED
}

enum RiderStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

enum RiderAvailability {
  ONLINE
  OFFLINE
  ON_DELIVERY
}

enum VehicleType {
  MOTORCYCLE
  BICYCLE
  CAR
  VAN
}

enum UtilityType {
  AIRTIME
  DATA
  ELECTRICITY
  CABLE
  EDUCATION_PIN
}

enum VtuPlanType {
  AIRTIME
  DATA
  CABLE
  ELECTRICITY
}

enum UtilityStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMerchant {
  ALRAHUZ
  KATPAY
}

// ============================================================
// MODELS
// ============================================================

/// Core user identity — shared by customers, riders, and admins.
/// Role determines which parts of the system the user can access.
model User {
  id             String      @id @default(uuid())
  email          String      @unique
  phone          String?     @unique
  firstName      String
  lastName       String
  passwordHash   String?     /// Hashed password for email/password login
  transactionPin String?     /// Hashed 6-digit PIN for financial operations
  bvnHash        String?     /// Hashed BVN — never store plaintext
  profilePicture String?     /// URL to profile picture (cloud storage)
  dateOfBirth    DateTime?   /// For KYC identity confirmation
  address        String?     /// Primary address text
  kycStatus      KycStatus   @default(NONE)
  role           UserRole    @default(CUSTOMER)
  status         UserStatus  @default(PENDING)
  fcmToken       String?     /// Firebase Cloud Messaging token for push notifications
  deletedAt      DateTime?   /// Soft delete

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  wallet        Wallet?
  rider         Rider?
  merchant      Merchant?         // NEW: If user is a merchant
  requests      Request[]         @relation("CustomerRequests")  // NEW: Unified requests
  customerOrders  DeliveryOrder[] @relation("CustomerOrders")   // LEGACY: To be migrated
  ratingsGiven    Rating[]        @relation("RatingsGiven")
  beneficiaries   SavedBeneficiary[]
  sessions        Session[]
  notificationPreferences NotificationPreferences?

  @@index([phone])
  @@index([email])
  @@index([role, status])
  @@map("users")
}

/// Each user has exactly ONE wallet. All financial operations flow through this.
/// Balance must NEVER be updated directly — only through Prisma transactions
/// that simultaneously create a Transaction record.
model Wallet {
  id                  String    @id @default(uuid())
  userId              String    @unique
  balance             Decimal   @default(0) @db.Decimal(15, 2)
  virtualAccountNumber String?  @unique  /// KatPay virtual account number
  virtualAccountBank   String?            /// Bank name for virtual account
  virtualAccountName   String?            /// Account name for virtual account
  isLocked            Boolean   @default(false) /// Freeze wallet for fraud prevention

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  debitTransactions    Transaction[] @relation("DebitWallet")
  creditTransactions   Transaction[] @relation("CreditWallet")

  @@index([userId])
  @@index([virtualAccountNumber])
  @@map("wallets")
}

/// Immutable financial ledger. Every money movement creates a Transaction.
/// CRITICAL: Transactions are append-only. Never update or delete.
model Transaction {
  id              String            @id @default(uuid())
  reference       String            @unique  /// Unique reference for idempotency
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  amount          Decimal           @db.Decimal(15, 2)
  fee             Decimal           @default(0) @db.Decimal(15, 2)
  description     String?
  metadata        Json?             /// Merchant-specific data (KatPay ref, AlRahuz token, etc.)

  // Wallet relations — a transaction debits one wallet and/or credits another
  debitWalletId   String?
  creditWalletId  String?

  // Merchant tracking
  merchant        PaymentMerchant?
  merchantRef     String?           /// External merchant reference

  // Balances at time of transaction (for audit trail)
  balanceBefore   Decimal?          @db.Decimal(15, 2)
  balanceAfter    Decimal?          @db.Decimal(15, 2)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  debitWallet     Wallet?           @relation("DebitWallet", fields: [debitWalletId], references: [id])
  creditWallet    Wallet?           @relation("CreditWallet", fields: [creditWalletId], references: [id])

  @@index([debitWalletId])
  @@index([creditWalletId])
  @@index([reference])
  @@index([type, status])
  @@index([createdAt])
  @@map("transactions")
}

/// Delivery order — tracks the full lifecycle from request to settlement.
model DeliveryOrder {
  id              String          @id @default(uuid())
  status          DeliveryStatus  @default(REQUESTED)

  // Customer
  customerId      String

  // Rider (assigned after matching)
  riderId         String?

  // Pickup details
  pickupAddress   String
  pickupLat       Float
  pickupLng       Float

  // Dropoff details
  dropoffAddress  String
  dropoffLat      Float
  dropoffLng      Float

  // Item info
  itemDescription String?
  packageSize     String?         /// e.g., "small", "medium", "large"

  // Pricing
  distanceKm      Float?
  fare            Decimal?        @db.Decimal(15, 2)
  platformFee     Decimal         @default(0) @db.Decimal(15, 2)

  // Tracking
  transactionId   String?         /// Reference to the payment transaction

  // Timestamps for each lifecycle stage
  matchedAt       DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  settledAt       DateTime?
  cancelledAt     DateTime?
  cancellationReason String?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  customer        User            @relation("CustomerOrders", fields: [customerId], references: [id])
  rider           Rider?          @relation(fields: [riderId], references: [id])
  ratings         Rating[]        // LEGACY: Support old ratings during migration

  @@index([customerId])
  @@index([riderId])
  @@index([status])
  @@index([createdAt])
  @@map("delivery_orders")
}

/// Rider profile — linked to a User with role=RIDER.
/// Contains vehicle info, verification docs, and performance metrics.
model Rider {
  id              String            @id @default(uuid())
  userId          String            @unique

  // Vehicle info
  vehicleType     VehicleType
  plateNumber     String
  vehicleColor    String?

  // Verification documents
  ninNumber       String?           /// National Identification Number (hashed)
  idDocumentUrl   String?           /// Uploaded government ID
  vehiclePhotoUrl String?           /// Uploaded vehicle photo

  // Status
  status          RiderStatus       @default(PENDING_APPROVAL)
  availability    RiderAvailability @default(OFFLINE)

  // Performance
  averageRating   Float             @default(0)
  totalDeliveries Int               @default(0)
  totalEarnings   Decimal           @default(0) @db.Decimal(15, 2)

  // Location (last known)
  lastLat         Float?
  lastLng         Float?
  lastLocationAt  DateTime?

  deletedAt       DateTime?         /// Soft delete

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests        Request[]         // NEW: Unified requests
  deliveryOrders  DeliveryOrder[]   // LEGACY: To be migrated
  ratingsReceived Rating[]          @relation("RiderRatings")

  @@index([userId])
  @@index([status, availability])
  @@index([lastLat, lastLng])
  @@map("riders")
}

/// Utility bill payment — airtime, data, electricity.
model UtilityPayment {
  id              String          @id @default(uuid())
  userId          String
  type            UtilityType
  status          UtilityStatus   @default(PENDING)

  // Payment details
  merchant        String          /// e.g., "MTN", "AEDC", "IKEDC"
  amount          Decimal         @db.Decimal(15, 2)
  phoneNumber     String?         /// For airtime/data
  meterNumber     String?         /// For electricity
  plan            String?         /// Data plan code or description

  // Provider tracking (AlRahuz)
  providerRequestId String?       @unique
  providerRef     String?

  // Result
  token           String?         /// Electricity token returned
  transactionId   String?         /// Reference to wallet Transaction

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([type, status])
  @@index([createdAt])
  @@map("utility_payments")
}

/// Admin-managed VTU plan catalogue. Admin sets AlRahuz IDs + selling prices.
model VtuPlan {
  id                String      @id @default(uuid())
  type              VtuPlanType
  providerNetworkId Int?        /// AlRahuz network/cable provider ID
  networkName       String?     /// "MTN", "GOTV" etc.
  providerPlanId    Int?        /// AlRahuz plan ID (data/cable plans)
  name              String      /// Display name e.g. "1GB - 30 Days"
  dataSize          String?     /// "1GB" for data plans
  validity          String?     /// "30 Days"
  planType          String?     /// "SME", "GIFTING" etc. for data plans
  costPrice         Decimal     @db.Decimal(15, 2)
  sellingPrice      Decimal     @db.Decimal(15, 2)
  isActive          Boolean     @default(true)
  sortOrder         Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([type, isActive])
  @@index([providerNetworkId, type])
  @@map("vtu_plans")
}

/// Post-delivery rating from customer to rider (and optionally merchant).
model Rating {
  id              String        @id @default(uuid())
  
  // LEGACY: Link to old DeliveryOrder (will be removed after migration)
  deliveryOrderId String?       @unique
  deliveryOrder   DeliveryOrder? @relation(fields: [deliveryOrderId], references: [id])
  
  // NEW: Link to unified Request
  requestId       String?       @unique
  request         Request?      @relation(fields: [requestId], references: [id])
  
  riderId         String
  customerId      String
  
  // Can rate both merchant and rider (if applicable)
  merchantScore   Int?          // 1-5 stars for merchant (if food/grocery/pharmacy)
  riderScore      Int?          // 1-5 stars for rider
  
  merchantComment String?
  riderComment    String?

  createdAt       DateTime      @default(now())

  // Relations
  rider           Rider         @relation("RiderRatings", fields: [riderId], references: [id])
  customer        User          @relation("RatingsGiven", fields: [customerId], references: [id])

  @@index([riderId])
  @@index([customerId])
  @@index([requestId])
  @@map("ratings")
}

/// Saved beneficiaries for quick repeat transfers and payments.
model SavedBeneficiary {
  id              String      @id @default(uuid())
  userId          String
  name            String      /// Display name
  phone           String?     /// For P2P transfers
  bankCode        String?     /// For bank withdrawals
  accountNumber   String?     /// For bank withdrawals
  accountName     String?     /// Verified account name

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phone])
  @@unique([userId, accountNumber, bankCode])
  @@index([userId])
  @@map("saved_beneficiaries")
}

// ============================================================
// UNIFIED REQUEST ARCHITECTURE — NEW MODELS
// ============================================================

/// Merchant — Restaurants, Supermarkets, Pharmacies
model Merchant {
  id              String          @id @default(uuid())

  // User account (optional — standalone merchants possible)
  userId          String?         @unique
  user            User?           @relation(fields: [userId], references: [id])

  categoryId      String
  category        MerchantCategory @relation(fields: [categoryId], references: [id])
  status          MerchantStatus  @default(PENDING_APPROVAL)

  // Business info
  name            String
  description     String?
  phone           String
  email           String?

  // Location
  address         String
  lat             Float
  lng             Float

  // Operating hours
  openingTime     String          @default("08:00")
  closingTime     String          @default("22:00")

  // Media
  logoUrl         String?
  coverImageUrl   String?

  // Settings
  isActive        Boolean         @default(true)
  isOpen          Boolean         @default(false)
  commissionRate  Float           @default(15)  // Platform commission %

  // Admin-controlled visibility override (independent of merchant's isOpen flag)
  adminActiveOverride Boolean     @default(true)

  // Status tracking
  suspensionReason   String?
  rejectionReason    String?

  // Phone OTP verification
  phoneVerified      Boolean      @default(false)

  // Performance
  averageRating   Float           @default(0)
  totalOrders     Int             @default(0)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  requests           Request[]
  products           Product[]
  wallet             MerchantWallet?
  commissionHistory  CommissionHistory[]
  tags               MerchantTag[]

  @@index([categoryId])
  @@index([status])
  @@index([isActive, isOpen])
  @@index([lat, lng])
  @@map("merchants")
}

/// Tracks every commission rate change for a merchant — full audit trail.
model CommissionHistory {
  id            String   @id @default(uuid())
  merchantId    String
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  previousRate  Float
  newRate       Float
  changedBy     String   /// Admin user ID who made the change
  reason        String?

  createdAt     DateTime @default(now())

  @@index([merchantId])
  @@index([createdAt])
  @@map("commission_history")
}

/// Merchant primary category — admin-managed taxonomy. Replaces the hardcoded MerchantType enum.
/// One category per merchant (Merchant.categoryId). For multi-tagging, see Tag.
model MerchantCategory {
  id             String     @id @default(uuid())
  name           String     @unique
  slug           String     @unique
  description    String?
  icon           String?
  color          String?
  sortOrder      Int        @default(0)
  hasPreparation Boolean    @default(true)
  isActive       Boolean    @default(true)

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  merchants      Merchant[]

  @@index([isActive, sortOrder])
  @@map("merchant_categories")
}

/// Global tag taxonomy — admin-managed, assigned to merchants for search/filtering in customer app.
model Tag {
  id          String        @id @default(uuid())
  name        String        @unique
  slug        String        @unique  /// URL-safe version of name
  category    String?       /// Grouping: e.g., "cuisine", "fashion", "health"
  color       String?       /// Hex color for UI display
  icon        String?       /// Icon name or URL
  isActive    Boolean       @default(true)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  merchants   MerchantTag[]

  @@index([category])
  @@index([isActive])
  @@map("tags")
}

/// Join table: merchant ↔ tag (many-to-many)
model MerchantTag {
  id         String   @id @default(uuid())
  merchantId String
  tagId      String

  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([merchantId, tagId])
  @@index([merchantId])
  @@index([tagId])
  @@map("merchant_tags")
}

/// Merchant Wallet — Separate from user wallet, tracks earnings
model MerchantWallet {
  id               String   @id @default(uuid())
  merchantId       String   @unique
  merchant         Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  // Available for withdrawal
  availableBalance Decimal @default(0) @db.Decimal(15, 2)

  // Held in escrow (pending settlement)
  pendingBalance   Decimal @default(0) @db.Decimal(15, 2)

  // Total all-time earnings
  totalEarnings    Decimal @default(0) @db.Decimal(15, 2)

  // Bank details for payout
  bankCode         String?
  accountNumber    String?
  accountName      String?

  // Wallet lock (set on suspension)
  isLocked         Boolean  @default(false)

  // Withdrawal hold: freeze payouts without suspending operations
  withdrawalHeld   Boolean  @default(false)
  withdrawalHoldReason String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  transactions     MerchantWalletTransaction[]

  @@map("merchant_wallets")
}

/// Merchant withdrawal ledger — tracks every payout request and its KatPay status.
model MerchantWalletTransaction {
  id               String        @id @default(uuid())
  reference        String        @unique

  merchantWalletId String
  merchantWallet   MerchantWallet @relation(fields: [merchantWalletId], references: [id], onDelete: Cascade)

  type             String        /// WITHDRAWAL
  status           String        /// PENDING | PROCESSING | COMPLETED | FAILED | REJECTED
  amount           Decimal       @db.Decimal(15, 2)

  // Bank details captured at request time
  bankCode         String?
  accountNumber    String?
  accountName      String?

  // KatPay tracking
  katpayReference  String?

  rejectionReason  String?
  processedAt      DateTime?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([merchantWalletId, status])
  @@index([reference])
  @@map("merchant_wallet_transactions")
}

/// Product — Menu items, grocery products, pharmacy items
model Product {
  id          String   @id @default(uuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  name        String
  description String?
  category    String

  basePrice   Decimal  @db.Decimal(15, 2)
  stock       Int      @default(0)

  // Variations (JSON for flexibility)
  variations  Json?

  // Options/Addons
  options     Json?

  imageUrl    String?
  isAvailable Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  requestItems RequestItem[]

  @@index([merchantId])
  @@index([category])
  @@map("products")
}

/// Request — THE CENTRAL ENTITY (replaces DeliveryOrder)
/// Food, Grocery, Pharmacy, Package — all unified here
model Request {
  id              String          @id @default(uuid())
  type            RequestType     // MERCHANT_ORDER (any merchant fulfillment) or PACKAGE (courier)
  status          RequestStatus   @default(REQUESTED)
  
  // Customer
  customerId      String
  customer        User            @relation("CustomerRequests", fields: [customerId], references: [id])
  
  // Merchant (optional — package deliveries have no merchant)
  merchantId      String?
  merchant        Merchant?         @relation(fields: [merchantId], references: [id])
  
  // Rider (assigned later)
  riderId         String?
  rider           Rider?            @relation(fields: [riderId], references: [id])
  
  // Locations
  pickupAddress   String
  pickupLat     Float
  pickupLng     Float
  pickupName    String?           // "KFC Katsina", "John's House"
  
  dropoffAddress  String
  dropoffLat    Float
  dropoffLng    Float
  dropoffName   String?           // Customer's name or custom label
  
  // Pricing
  subtotal        Decimal         @db.Decimal(15, 2)  // Items cost (0 for package)
  deliveryFee     Decimal         @db.Decimal(15, 2)  // Always calculated
  platformFee     Decimal         @db.Decimal(15, 2)  // Platform commission
  tax             Decimal         @default(0) @db.Decimal(15, 2)
  total           Decimal         @db.Decimal(15, 2)  // What customer pays
  
  // Financial splits (CRITICAL — must exist from day one)
  customerPaid    Decimal         @db.Decimal(15, 2)
  merchantEarning Decimal         @default(0) @db.Decimal(15, 2)
  riderEarning    Decimal         @default(0) @db.Decimal(15, 2)
  platformEarning Decimal         @default(0) @db.Decimal(15, 2)
  
  // Distance/Time
  distanceKm      Float?
  estimatedMinutes Int?
  
  // Financial record
  transactionId        String?
  escrowTransactionId  String?   // Hold transaction reference
  refundTransactionId  String?   // Refund transaction reference

  // Matching
  searchAttempts       Int       @default(0)
  lastBroadcastAt      DateTime?
  cancellationFee      Decimal?  @db.Decimal(15, 2)

  // Cancellation
  cancelledAt     DateTime?
  cancelledBy     String?         // customer, merchant, rider, system
  cancellationReason String?
  
  // Timestamps for lifecycle
  acceptedAt      DateTime?
  processingAt    DateTime?
  readyAt         DateTime?
  riderAssignedAt DateTime?
  riderEnRouteAt  DateTime?
  pickedUpAt      DateTime?
  inTransitAt     DateTime?
  deliveredAt     DateTime?
  settledAt       DateTime?
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  // Relations
  items           RequestItem[]     // For food/grocery/pharmacy
  packageDetails  PackageDetail?    // For package delivery
  rating          Rating?
  
  @@index([customerId])
  @@index([merchantId])
  @@index([riderId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("requests")
}

/// RequestItem — Items within a request (food, groceries, pharmacy)
model RequestItem {
  id          String   @id @default(uuid())
  requestId   String
  request     Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  
  // Can link to product or be free-form
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  
  // Or free-form entry
  name        String
  description String?
  
  // Pricing at time of order
  unitPrice   Decimal  @db.Decimal(15, 2)
  quantity    Int      @default(1)
  
  // Variations/Options (JSON)
  variations  Json?
  
  totalPrice  Decimal  @db.Decimal(15, 2)  // unitPrice * quantity + variation costs
  
  createdAt   DateTime @default(now())
  
  @@index([requestId])
  @@index([productId])
  @@map("request_items")
}

/// PackageDetail — For package delivery (no merchant)
model PackageDetail {
  id          String   @id @default(uuid())
  requestId   String   @unique
  request     Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  
  description String
  size        String   // SMALL, MEDIUM, LARGE
  weight      Float?
  
  // Contact info at pickup
  senderName    String
  senderPhone   String
  
  // Recipient info
  recipientName   String
  recipientPhone  String
  
  // Special instructions
  instructions  String?
  
  createdAt   DateTime @default(now())
  
  @@map("package_details")
}


/// User sessions for JWT refresh token tracking.
model Session {
  id            String    @id @default(uuid())
  userId        String
  refreshToken  String    @unique
  deviceInfo    String?   /// Free-form device descriptor (legacy; superseded by deviceName/Model)
  deviceName    String?   /// User-set device name, e.g., "Bishir's iPhone"
  deviceModel   String?   /// Hardware model, e.g., "iPhone15,2", "Pixel 7 Pro"
  userAgent     String?   /// Raw User-Agent header captured at session creation
  ipAddress     String?
  lastUsedAt    DateTime  @default(now()) /// Updated on every token refresh
  expiresAt     DateTime
  isRevoked     Boolean   @default(false)

  createdAt     DateTime  @default(now())

  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("sessions")
}

/// User notification preferences — stored per user, synced across devices.
model NotificationPreferences {
  id                  String    @id @default(uuid())
  userId              String    @unique
  pushEnabled         Boolean   @default(true)
  orderUpdates        Boolean   @default(true)
  promotions          Boolean   @default(true)
  walletAlerts        Boolean   @default(true)
  emailEnabled        Boolean   @default(true)
  emailPromotions     Boolean   @default(false)
  smsEnabled          Boolean   @default(false)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification_preferences")
}

/// External payment-provider webhook event log — for idempotency and audit.
model WebhookEvent {
  id              String    @id @default(uuid())
  merchant        String    /// "katpay" (or other future providers)
  eventType       String    /// e.g., "SUCCESSFUL_TRANSACTION"
  transactionRef  String    @unique  /// External reference for deduplication
  payload         Json      /// Raw webhook payload
  processed       Boolean   @default(false)
  processedAt     DateTime?
  error           String?   /// Error message if processing failed

  createdAt       DateTime  @default(now())

  @@index([merchant, eventType])
  @@index([transactionRef])
  @@index([processed])
  @@map("webhook_events")
}

/// Platform-wide settings — admin-managed key/value store.
/// All fee constants, thresholds, and feature flags live here.
model PlatformSetting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?  /// Admin user ID

  @@map("platform_settings")
}

/// Idempotency keys — prevent duplicate mutations on mobile retry.
model IdempotencyKey {
  key              String   @id
  userId           String
  route            String
  requestHash      String
  responseSnapshot Json?
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  @@index([userId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// System-owned wallet for escrow and platform earnings.
model SystemWallet {
  id          String   @id
  name        String
  balance     Decimal  @default(0) @db.Decimal(15, 2)
  updatedAt   DateTime @updatedAt

  @@map("system_wallets")
}

/// Audit log — tracks all admin actions for compliance and debugging.
model AuditLog {
  id          String   @id @default(uuid())
  adminUserId String
  action      String   /// "APPROVE_MERCHANT", "SUSPEND_USER", etc.
  entityType  String   /// "MERCHANT", "USER", "RIDER", "REQUEST", etc.
  entityId    String   /// ID of the affected entity
  details     Json?    /// Additional context (e.g., reason, old value, new value)
  ipAddress   String?
  userAgent   String?

  createdAt   DateTime @default(now())

  @@index([adminUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
