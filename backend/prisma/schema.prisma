// ============================================================
// iPRIME - PRISMA SCHEMA
// Single Source of Truth for all data models
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  CUSTOMER
  RIDER
  ADMIN
  MERCHANT // NEW: Merchant/merchant role
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  FAILED
}

enum BvnVerificationOutcome {
  SUCCESS
  FAILED
  RECOVERY // Re-verify of an already-VERIFIED user (provisioning recovery path)
}

// ============================================================
// UNIFIED REQUEST ARCHITECTURE - NEW ENUMS
// ============================================================

enum RequestType {
  MERCHANT_ORDER // Any order fulfilled by a merchant (food, grocery, pharmacy, retail, etc.)
  PACKAGE // Pure courier - no merchant, customer is the origin
}

enum RequestStatus {
  REQUESTED // Customer placed order
  ACCEPTED // Merchant accepted (if applicable)
  PROCESSING // Merchant preparing (if applicable)
  READY_FOR_PICKUP // Ready for rider
  RIDER_ASSIGNED // Rider matched
  RIDER_EN_ROUTE // Rider going to pickup
  PICKED_UP // Rider has item
  IN_TRANSIT // Rider delivering to customer
  DELIVERED // Rider delivered
  SETTLED // Financial settlement complete
  CANCELLED // Cancelled by any party
}

enum MerchantStatus {
  PENDING_APPROVAL
  APPROVED
  SUSPENDED
  REJECTED
}

enum TransactionType {
  WALLET_FUNDING
  P2P_TRANSFER_SENT
  P2P_TRANSFER_RECEIVED
  WITHDRAWAL
  DELIVERY_PAYMENT // legacy; unused after Phase 2
  DELIVERY_EARNING // legacy; unused after Phase 2
  UTILITY_PAYMENT
  AIRTIME_TO_CASH // Customer sells airtime → wallet credit
  REFUND
  ESCROW_HOLD
  ESCROW_RELEASE
  ESCROW_REFUND
  PLATFORM_EARNING
  RIDER_EARNING
  MERCHANT_EARNING
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SENT // payout dispatched to provider, outcome not yet confirmed (at-most-once dispatch lock)
  COMPLETED
  FAILED
  REVERSED
}

enum RiderStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

enum RiderAvailability {
  ONLINE
  OFFLINE
  ON_DELIVERY
}

enum VehicleType {
  MOTORCYCLE
  BICYCLE
  CAR
  VAN
}

enum UtilityType {
  AIRTIME
  DATA
  ELECTRICITY
  CABLE
  EDUCATION_PIN
}

enum VtuPlanType {
  AIRTIME
  DATA
  CABLE
  ELECTRICITY
}

enum UtilityStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum AirtimeToCashStatus {
  AWAITING_OTP // /initiate called - OTP sent to sender
  OTP_VERIFIED // /verify succeeded - sessionId stored, awaiting /submit
  PROCESSING // /submit called - provider transferAirtime in flight
  COMPLETED // Provider code 2000 - wallet credited
  FAILED // Provider 3xxx/5030 or local validation failure
  NEEDS_RECONCILIATION // Provider code 4000 - no query API; admin resolves manually
}

enum AirtimeNetwork {
  MTN
  AIRTEL
  GLO
  NINEMOBILE // Maps to provider's "9MOBILE" code (Prisma enum can't start with a digit)
}

enum PaymentProvider {
  ALRAHUZ // legacy: retained so historical utility transactions keep their label
  BILALSADASUB
  KATPAY
  PAYSTACK
}

// ============================================================
// PRODUCT VARIANT & OPTION-GROUP ENUMS
// ============================================================

enum PackUnit {
  ML
  L
  G
  KG
  TABLET
  CAPSULE
  PIECE
  PAIR
  PACK
  BOTTLE
  SACHET
  CARTON
}

enum SelectionRule {
  REQUIRED_ONE
  OPTIONAL_ONE
  REQUIRED_MULTIPLE
  OPTIONAL_MULTIPLE
}

/// Grocery substitution preference per line item.
/// NONE          → customer wants the exact item or nothing at all.
/// MERCHANT_PICK → merchant may swap with a comparable item without asking.
/// CONTACT_ME    → merchant must reach out before swapping.
enum SubstitutionPreference {
  NONE
  MERCHANT_PICK
  CONTACT_ME
}

// ============================================================
// MODELS
// ============================================================

/// Core user identity - shared by customers, riders, and admins.
/// Role determines which parts of the system the user can access.
model User {
  id             String     @id @default(uuid())
  email          String     @unique
  phone          String?    @unique
  firstName      String
  lastName       String
  passwordHash   String? /// Hashed password for email/password login
  transactionPin String? /// Hashed 6-digit PIN for financial operations
  transactionPinSetByUser Boolean @default(false) /// True once the user chose their own PIN. Stays false for merchants seeded with the default '000000' - used to force a real PIN before financial actions.
  bvnHash        String? /// Hashed BVN - never store plaintext
  profilePicture String? /// URL to profile picture (cloud storage)
  dateOfBirth    DateTime? /// For KYC identity confirmation
  address        String? /// Primary address text
  kycStatus      KycStatus  @default(NONE)
  role           UserRole   @default(CUSTOMER)
  permissions    Json? /// Array of permission strings for ADMIN role. null/['ALL'] = super admin.
  status         UserStatus @default(PENDING)
  fcmToken       String? /// Firebase Cloud Messaging token for push notifications   
  deletedAt      DateTime? /// Soft delete

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  wallet                  Wallet?
  rider                   Rider?
  merchant                Merchant? // NEW: If user is a merchant
  requests                Request[]                @relation("CustomerRequests")
  ratingsGiven            Rating[]                 @relation("RatingsGiven")
  beneficiaries           SavedBeneficiary[]
  sessions                Session[]
  notificationPreferences NotificationPreferences?
  bvnVerificationLogs     BvnVerificationLog[]
  requestMessages         RequestMessage[]
  notifications           Notification[]
  savedAddresses          SavedAddress[]
  tickets                 SupportTicket[]          @relation("UserTickets")
  assignedTickets         SupportTicket[]          @relation("AssignedTickets")
  raisedDisputes          Dispute[]                @relation("RaisedDisputes")
  resolvedDisputes        Dispute[]                @relation("ResolvedDisputes")
  supportMessages         SupportMessage[]
  pushSubscriptions       PushSubscription[]

  @@index([phone])
  @@index([email])
  @@index([role, status])
  @@map("users")
}

/// Each user has exactly ONE wallet. All financial operations flow through this.
/// Balance must NEVER be updated directly - only through Prisma transactions
/// that simultaneously create a Transaction record.
model Wallet {
  id                   String  @id @default(uuid())
  userId               String  @unique
  balance              Decimal @default(0) @db.Decimal(15, 2)
  virtualAccountNumber String? @unique /// Active funding NUBAN (Paystack DVA post-migration; was KatPay)
  virtualAccountBank   String? /// Bank name for virtual account
  virtualAccountName   String? /// Account name for virtual account
  isLocked             Boolean @default(false) /// Freeze wallet for fraud prevention

  // Paystack Dedicated Virtual Account linkage. customerCode is needed to
  // create/track the DVA and to match the funding customer on charge.success.
  paystackCustomerCode String? @unique /// Paystack customer code (CUS_...)
  dedicatedAccountId   String? /// Paystack dedicated_account id (numeric, stored as string)

  // Old KatPay NUBAN, retained after the Paystack cutover so a straggler transfer
  // to a number a user saved in their bank app still credits the wallet (the
  // inbound KatPay webhook resolves the wallet by this field). KatPay cannot
  // deactivate NUBANs, so this is the only way late funding stays automatic.
  legacyKatpayAccountNumber String? @unique /// Pre-Paystack KatPay NUBAN

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  debitTransactions  Transaction[] @relation("DebitWallet")
  creditTransactions Transaction[] @relation("CreditWallet")

  @@index([userId])
  @@index([virtualAccountNumber])
  @@map("wallets")
}

/// Immutable financial ledger. Every money movement creates a Transaction.
/// CRITICAL: Transactions are append-only. Never update or delete.
model Transaction {
  id          String            @id @default(uuid())
  reference   String            @unique /// Unique reference for idempotency
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  amount      Decimal           @db.Decimal(15, 2)
  fee         Decimal           @default(0) @db.Decimal(15, 2)
  description String?
  metadata    Json? /// Provider-specific data (KatPay ref, AlRahuz token, etc.)

  // Wallet relations - a transaction debits one wallet and/or credits another
  debitWalletId  String?
  creditWalletId String?

  // Payment provider tracking (KatPay, AlRahuz, etc.)
  provider    PaymentProvider?
  providerRef String? /// External provider reference

  // Balances at time of transaction (for audit trail)
  balanceBefore Decimal? @db.Decimal(15, 2)
  balanceAfter  Decimal? @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  debitWallet   Wallet?  @relation("DebitWallet", fields: [debitWalletId], references: [id])
  creditWallet  Wallet?  @relation("CreditWallet", fields: [creditWalletId], references: [id])
  disputeRefund Dispute? @relation("DisputeRefund")

  @@index([debitWalletId])
  @@index([creditWalletId])
  @@index([reference])
  @@index([type, status])
  @@index([createdAt])
  @@map("transactions")
}

/// Rider profile - linked to a User with role=RIDER.
/// Contains vehicle info, verification docs, and performance metrics.
model Rider {
  id     String @id @default(uuid())
  userId String @unique

  // Vehicle info
  vehicleType  VehicleType
  plateNumber  String
  vehicleColor String?

  // Verification documents
  ninNumber       String? /// National Identification Number (hashed)
  idDocumentUrl   String? /// Uploaded government ID
  vehiclePhotoUrl String? /// Uploaded vehicle photo

  // Phase 7 - expiry tracking + supplementary documents for KYC Status screen.
  idDocExpiresAt         DateTime? /// Expiry on the uploaded ID doc (national-ID slips usually have one)
  driverLicenceNumber    String? /// FRSC licence number as typed by the rider
  driverLicenceUrl       String?
  driverLicenceExpiresAt DateTime?
  vehicleRegUrl          String?
  vehicleRegExpiresAt    DateTime?
  vehicleDocExpiresAt    DateTime? /// Generic vehicle-doc expiry - earliest of vehicleReg/insurance for sort
  insuranceDocUrl        String?
  insuranceExpiresAt     DateTime?
  /// Throttle marker for the nightly DOC_EXPIRING_SOON push so a rider isn't
  /// spammed every 24h once a doc enters the 14-day window.
  lastDocExpiryNoticeAt  DateTime?

  // Status
  status           RiderStatus       @default(PENDING_APPROVAL)
  availability     RiderAvailability @default(OFFLINE)
  suspensionReason String? /// Set when an admin suspends the rider; cleared on unsuspend
  rejectionReason  String? /// Set when an admin rejects the application; cleared on re-upload / re-approval

  // Performance
  averageRating   Float   @default(0)
  totalDeliveries Int     @default(0)
  totalEarnings   Decimal @default(0) @db.Decimal(15, 2)

  // Location (last known)
  lastLat        Float?
  lastLng        Float?
  lastLocationAt DateTime?

  deletedAt DateTime? /// Soft delete

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests        Request[]
  ratingsReceived Rating[]        @relation("RiderRatings")
  offerLogs       RiderOfferLog[]

  @@index([userId])
  @@index([status, availability])
  @@index([lastLat, lastLng])
  @@index([idDocExpiresAt])
  @@index([vehicleDocExpiresAt])
  @@map("riders")
}

/// RiderOfferLog - one row per offer the dispatcher emits to a rider.
/// Powers acceptance/decline rate metrics on the rider performance screen.
enum RiderOfferOutcome {
  OFFERED /// Initial state when emitRing pushed the offer.
  ACCEPTED /// Rider claimed the job.
  DECLINED /// Rider tapped decline in the offer sheet.
  EXPIRED /// Ring timeout elapsed with no response.
  TAKEN /// Another rider claimed the job before this one could.
}

model RiderOfferLog {
  id          String            @id @default(uuid())
  riderId     String
  requestId   String
  outcome     RiderOfferOutcome @default(OFFERED)
  ringAttempt Int               @default(0)
  distanceKm  Float?
  offeredAt   DateTime          @default(now())
  respondedAt DateTime?

  rider   Rider   @relation(fields: [riderId], references: [id], onDelete: Cascade)
  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([riderId, requestId])
  @@index([riderId, offeredAt(sort: Desc)])
  @@index([requestId])
  @@map("rider_offer_logs")
}

/// Utility bill payment - airtime, data, electricity.
model UtilityPayment {
  id     String        @id @default(uuid())
  userId String
  type   UtilityType
  status UtilityStatus @default(PENDING)

  // Payment details
  biller      String /// e.g., "MTN", "AEDC", "IKEDC"
  amount      Decimal @db.Decimal(15, 2)
  phoneNumber String? /// For airtime/data
  meterNumber String? /// For electricity
  plan        String? /// Data plan code or description

  // Provider tracking. `provider` records which VTU adapter currently holds the
  // payment, so the poll/reconcile loop queries the right API and a failover to
  // the secondary stays on that provider. Null = the (default) primary.
  provider          PaymentProvider?
  providerRequestId String?          @unique
  providerRef       String? /// The provider's own txn id (used to poll AlRahuz)
  // Per-provider numeric IDs for this purchase ({ BILALSADASUB: {...}, ALRAHUZ:
  // {...}|null }). Persisted so the reconcile/sweep paths can fail over to the
  // secondary too, not just the live worker pass.
  providerIds       Json?

  // Result
  token           String? /// Electricity token returned (delivered + STKN)
  beneficiaryName String? /// Verified meter / IUC owner name
  transactionId   String? /// Reference to wallet Transaction

  // Reconciliation (async provider pending → poll)
  pollAttempts Int       @default(0)
  lastPolledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type, status])
  @@index([createdAt])
  @@map("utility_payments")
}

/// Airtime-to-cash transaction (customer sells airtime → wallet credit).
/// Provider: airtimetocash.com (Automation API).
/// Flow: AWAITING_OTP → OTP_VERIFIED → PROCESSING → COMPLETED / FAILED / NEEDS_RECONCILIATION.
model AirtimeToCashTransaction {
  id     String              @id @default(uuid())
  userId String
  status AirtimeToCashStatus @default(AWAITING_OTP)

  // Sender details - the customer's SIM that holds the airtime.
  network     AirtimeNetwork
  senderPhone String /// Normalized 11-digit (e.g. 08061234573)

  // Economics
  airtimeAmount Decimal @db.Decimal(15, 2) /// Amount of airtime being sold
  payoutAmount  Decimal @db.Decimal(15, 2) /// Amount credited to wallet (airtimeAmount × payoutRate)
  payoutRate    Decimal @db.Decimal(5, 4) /// Snapshot of the rate at submit-time (e.g. 0.7500)

  // Provider tracking - `reference` is sent on transfer, must be unique 10–40 chars.
  reference         String  @unique
  providerSessionId String? /// Returned by /verify-otp; required for /transfer-airtime
  providerCode      Int? /// Last provider response code (2000, 4000, 3000, etc.)
  providerMessage   String? /// Raw provider message for debugging / admin reconciliation
  automationCharges String? /// Whatever the provider reported (e.g. "₦2")

  // Wallet credit linkage (set once COMPLETED)
  transactionId String? /// FK to Transaction.reference

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  verifiedAt  DateTime? /// When OTP was verified
  submittedAt DateTime? /// When /submit was called
  resolvedAt  DateTime? /// When status reached a terminal state (COMPLETED / FAILED / NEEDS_RECONCILIATION)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("airtime_to_cash_transactions")
}

/// Admin-managed VTU plan catalogue. Admin sets provider IDs + selling prices.
/// `providerNetworkId` + `networkName` are kept in sync with the parent
/// VtuNetwork row via a server-side sweep when the network is edited.
model VtuPlan {
  id                String      @id @default(uuid())
  type              VtuPlanType
  providerNetworkId Int? /// Primary (BilalSada) network/cable/disco ID
  networkName       String? /// "MTN", "GOTV" etc. (denormalized)
  providerPlanId    Int? /// Primary (BilalSada) plan ID (data/cable plans)
  // Secondary (AlRahuz) IDs - used when a purchase fails over to AlRahuz. Null
  // when AlRahuz isn't mapped for this plan; such a plan simply can't fail over.
  altProviderNetworkId Int?
  altProviderPlanId    Int?
  name              String /// Display name e.g. "1GB - 30 Days"
  dataSize          String? /// "1GB" for data plans
  validity          String? /// "30 Days"
  planType          String? /// "SME", "GIFTING" etc. for data plans
  costPrice         Decimal     @db.Decimal(15, 2)
  sellingPrice      Decimal     @db.Decimal(15, 2)
  isActive          Boolean     @default(true)
  sortOrder         Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([type, isActive])
  @@index([providerNetworkId, type])
  @@map("vtu_plans")
}

/// Provider-agnostic catalogue of networks/cable names/discos. Admin edits
/// these from the dashboard so a provider ID change does not require a deploy.
/// Switching VTU providers = swap the provider adapter (currently
/// bilalsada.service) + reload this catalogue with the new provider's IDs.
model VtuNetwork {
  id                String      @id @default(uuid())
  type              VtuPlanType
  providerNetworkId Int /// The integer the primary (BilalSada) API expects
  altProviderNetworkId Int? /// The integer AlRahuz expects (failover); null = unmapped
  name              String /// Display name e.g. "MTN", "DSTV", "Ikeja"
  isActive          Boolean     @default(true)
  sortOrder         Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([type, providerNetworkId])
  @@index([type, isActive])
  @@map("vtu_networks")
}

/// Post-delivery rating from customer to rider (and optionally merchant).
model Rating {
  id String @id @default(uuid())

  requestId String  @unique
  request   Request @relation(fields: [requestId], references: [id])

  riderId    String
  customerId String

  // Can rate both merchant and rider (if applicable)
  merchantScore Int? // 1-5 stars for merchant (if food/grocery/pharmacy)
  riderScore    Int? // 1-5 stars for rider

  merchantComment String?
  riderComment    String?

  createdAt DateTime @default(now())

  // Relations
  rider    Rider @relation("RiderRatings", fields: [riderId], references: [id])
  customer User  @relation("RatingsGiven", fields: [customerId], references: [id])

  @@index([riderId])
  @@index([customerId])
  @@index([requestId])
  @@map("ratings")
}

/// Saved beneficiaries for quick repeat transfers and payments.
model SavedBeneficiary {
  id            String  @id @default(uuid())
  userId        String
  name          String /// Display name
  phone         String? /// For P2P transfers
  bankCode      String? /// For bank withdrawals
  accountNumber String? /// For bank withdrawals
  accountName   String? /// Verified account name

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phone])
  @@unique([userId, accountNumber, bankCode])
  @@index([userId])
  @@map("saved_beneficiaries")
}

// ============================================================
// UNIFIED REQUEST ARCHITECTURE - NEW MODELS
// ============================================================

/// Merchant - Restaurants, Supermarkets, Pharmacies
model Merchant {
  id String @id @default(uuid())

  // User account (optional - standalone merchants possible)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  categoryId String
  category   MerchantCategory @relation(fields: [categoryId], references: [id])
  status     MerchantStatus   @default(PENDING_APPROVAL)

  // Business info
  name        String
  description String?
  phone       String
  email       String?

  // Location
  address String
  lat     Float
  lng     Float

  // Operating hours
  openingTime String   @default("08:00")
  closingTime String   @default("22:00")
  openingDays String[] @default(["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"])

  // Media
  logoUrl       String?
  coverImageUrl String?

  // Settings
  isActive       Boolean @default(true)
  isOpen         Boolean @default(false)
  commissionRate Float   @default(15) // Platform commission %

  // Admin-controlled visibility override (independent of merchant's isOpen flag)
  adminActiveOverride Boolean @default(true)

  // Status tracking
  suspensionReason String?
  rejectionReason  String?

  // Phone OTP verification
  phoneVerified Boolean @default(false)

  // Performance
  averageRating Float @default(0)
  totalOrders   Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Full-text search vector, generated and maintained by Postgres from
  /// name (weight A) + description (weight B). Created in the
  /// search_fts_hybrid migration; declared Unsupported so Prisma keeps it
  /// on diff. Never written from application code.
  search_vector Unsupported("tsvector")?

  // Relations
  requests          Request[]
  products          Product[]
  wallet            MerchantWallet?
  commissionHistory CommissionHistory[]
  tags              MerchantTag[]

  @@index([categoryId])
  @@index([status])
  @@index([isActive, isOpen])
  @@index([lat, lng])
  @@index([search_vector], type: Gin)
  @@map("merchants")
}

/// Tracks every commission rate change for a merchant - full audit trail.
model CommissionHistory {
  id         String   @id @default(uuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  previousRate Float
  newRate      Float
  changedBy    String /// Admin user ID who made the change
  reason       String?

  createdAt DateTime @default(now())

  @@index([merchantId])
  @@index([createdAt])
  @@map("commission_history")
}

/// Merchant primary category - admin-managed taxonomy. Replaces the hardcoded MerchantType enum.
/// One category per merchant (Merchant.categoryId). For multi-tagging, see Tag.
model MerchantCategory {
  id             String  @id @default(uuid())
  name           String  @unique
  slug           String  @unique
  description    String?
  icon           String?
  color          String?
  sortOrder      Int     @default(0)
  hasPreparation Boolean @default(true)
  isActive       Boolean @default(true)

  /// Admin-managed schema hint for which axes and pack units a category uses.
  /// Shape: { axes: string[], pack: boolean, packUnits?: PackUnit[], sizeSystem?: string, ... }
  /// Pure UX hint; DB does not enforce. Consumed by merchant + customer apps.
  attributeSchema Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchants Merchant[]

  @@index([isActive, sortOrder])
  @@map("merchant_categories")
}

/// Global tag taxonomy - admin-managed, assigned to merchants for search/filtering in customer app.
model Tag {
  id       String  @id @default(uuid())
  name     String  @unique
  slug     String  @unique /// URL-safe version of name
  category String? /// Grouping: e.g., "cuisine", "fashion", "health"
  color    String? /// Hex color for UI display
  icon     String? /// Icon name or URL
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  merchants MerchantTag[]

  @@index([category])
  @@index([isActive])
  @@map("tags")
}

/// Join table: merchant ↔ tag (many-to-many)
model MerchantTag {
  id         String @id @default(uuid())
  merchantId String
  tagId      String

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([merchantId, tagId])
  @@index([merchantId])
  @@index([tagId])
  @@map("merchant_tags")
}

/// Merchant Wallet - Separate from user wallet, tracks earnings
model MerchantWallet {
  id         String   @id @default(uuid())
  merchantId String   @unique
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  // Available for withdrawal
  availableBalance Decimal @default(0) @db.Decimal(15, 2)

  // Held in escrow (pending settlement)
  pendingBalance Decimal @default(0) @db.Decimal(15, 2)

  // Total all-time earnings
  totalEarnings Decimal @default(0) @db.Decimal(15, 2)

  // Bank details for payout
  bankCode      String?
  accountNumber String?
  accountName   String?

  // Wallet lock (set on suspension)
  isLocked Boolean @default(false)

  // Withdrawal hold: freeze payouts without suspending operations
  withdrawalHeld       Boolean @default(false)
  withdrawalHoldReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  transactions MerchantWalletTransaction[]

  @@map("merchant_wallets")
}

/// Merchant withdrawal ledger - tracks every payout request and its KatPay status.
model MerchantWalletTransaction {
  id        String @id @default(uuid())
  reference String @unique

  merchantWalletId String
  merchantWallet   MerchantWallet @relation(fields: [merchantWalletId], references: [id], onDelete: Cascade)

  type   String /// WITHDRAWAL
  status String /// PENDING | PROCESSING | COMPLETED | FAILED | REJECTED
  amount Decimal @db.Decimal(15, 2)

  // Bank details captured at request time
  bankCode      String?
  accountNumber String?
  accountName   String?

  // KatPay tracking
  katpayReference String?

  rejectionReason String?
  processedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantWalletId, status])
  @@index([reference])
  @@map("merchant_wallet_transactions")
}

/// Product - Menu items, grocery products, pharmacy items.
/// `basePrice` and `stock` are kept for fallback display when a product has a
/// single default variant. Multi-SKU products carry pricing/stock on `ProductVariant`.
model Product {
  id         String   @id @default(uuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  name        String
  description String?
  category    String

  basePrice Decimal @db.Decimal(15, 2)
  stock     Int     @default(0)

  // Pharmacy-specific (Phase 8 reads these; Phase 2 lands the columns)
  requiresPrescription Boolean @default(false)
  dosage               String?

  imageUrl    String?
  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Full-text search vector, generated and maintained by Postgres from
  /// name (A) + description (B) + category (C). Created in the
  /// search_fts_hybrid migration; declared Unsupported so Prisma keeps it
  /// on diff. Never written from application code.
  search_vector Unsupported("tsvector")?

  // Relations
  variants     ProductVariant[]
  optionGroups ProductOptionGroup[]
  requestItems RequestItem[]

  @@index([merchantId])
  @@index([category])
  @@index([search_vector], type: Gin)
  @@map("products")
}

/// ProductVariant - SKU-level variation of a product.
/// Every Product has at least one variant (default created for single-SKU products).
/// `attributes` is the discrete-axis JSON; `packSize/packUnit/packLabel` is the unit/pack.
model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku        String?
  /// Discrete selection axes, schema-less so each category names its own.
  /// e.g. {size:"M", color:"Black"} or {strength:"500mg", form:"TABLET"}
  attributes Json    @default("{}")

  /// Pack/unit fields - null for variants where category isn't pack-based.
  packSize  Decimal?  @db.Decimal(15, 4)
  packUnit  PackUnit?
  /// Denormalized human-readable pack label, e.g. "500 ml", "30 tablets".
  packLabel String?

  price       Decimal @db.Decimal(15, 2)
  stock       Int     @default(0)
  imageUrl    String?
  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestItems RequestItem[]

  @@unique([productId, sku])
  @@index([productId])
  @@index([productId, isAvailable])
  @@map("product_variants")
}

/// ProductOptionGroup - customer-facing customization group on a product
/// (sides, spice level, addons, etc.). Combinable with variants for combos.
model ProductOptionGroup {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name          String /// "Sides", "Spice level", "Pick a drink"
  selectionRule SelectionRule
  minSelect     Int           @default(0)
  maxSelect     Int           @default(1)
  sortOrder     Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ProductOptionItem[]

  @@index([productId, sortOrder])
  @@map("product_option_groups")
}

/// ProductOptionItem - a single selectable item inside an option group.
model ProductOptionItem {
  id      String             @id @default(uuid())
  groupId String
  group   ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name        String /// "Plantain", "Extra cheese", "Mild"
  description String? /// Optional flavour-text shown under the item name in the customer cart
  /// Price delta applied on top of the variant price. Defaults to 0 for price-neutral picks.
  priceDelta  Decimal @default(0) @db.Decimal(15, 2)
  imageUrl    String? /// Cloudinary URL - lets merchants show a picture of the add-on (e.g. an actual photo of the plantain side)
  isDefault   Boolean @default(false)
  isAvailable Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId, sortOrder])
  @@map("product_option_items")
}

/// Request - THE CENTRAL ENTITY (replaces DeliveryOrder)
/// Food, Grocery, Pharmacy, Package - all unified here
model Request {
  id     String        @id @default(uuid())
  type   RequestType // MERCHANT_ORDER (any merchant fulfillment) or PACKAGE (courier)
  status RequestStatus @default(REQUESTED)

  // Customer
  customerId String
  customer   User   @relation("CustomerRequests", fields: [customerId], references: [id])

  // Merchant (optional - package deliveries have no merchant)
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id])

  // Rider (assigned later)
  riderId String?
  rider   Rider?  @relation(fields: [riderId], references: [id])

  // Locations
  pickupAddress String
  pickupLat     Float
  pickupLng     Float
  pickupName    String? // "KFC Katsina", "John's House"

  dropoffAddress String
  dropoffLat     Float
  dropoffLng     Float
  dropoffName    String? // Customer's name or custom label

  // Pricing
  subtotal    Decimal @db.Decimal(15, 2) // Items cost (0 for package)
  deliveryFee Decimal @db.Decimal(15, 2) // Always calculated
  platformFee Decimal @db.Decimal(15, 2) // Platform commission
  tax         Decimal @default(0) @db.Decimal(15, 2)
  total       Decimal @db.Decimal(15, 2) // What customer pays

  // Financial splits (CRITICAL - must exist from day one)
  customerPaid    Decimal @db.Decimal(15, 2)
  merchantEarning Decimal @default(0) @db.Decimal(15, 2)
  riderEarning    Decimal @default(0) @db.Decimal(15, 2)
  platformEarning Decimal @default(0) @db.Decimal(15, 2)

  // Distance/Time
  distanceKm       Float?
  estimatedMinutes Int?

  // Financial record
  transactionId       String?
  escrowTransactionId String? // Hold transaction reference
  refundTransactionId String? // Refund transaction reference

  // Matching
  searchAttempts  Int       @default(0)
  lastBroadcastAt DateTime?
  cancellationFee Decimal?  @db.Decimal(15, 2)

  /// Pharmacy: signed Cloudinary URL of the prescription doc the customer
  /// attached at checkout. Required server-side when any RequestItem points at
  /// a Product with `requiresPrescription = true`. Persisted as an audit trail
  /// of which physical prescription the order was fulfilled against.
  prescriptionUrl String?

  /// Phase 5 - Proof of Delivery. Captured by the rider at DELIVERED time and
  /// gated by platform settings (`delivery.requirePodPhoto`,
  /// `delivery.requireSignature`, `delivery.podOtpThresholdNgn`).
  ///   - `podPhotoUrl`        - Cloudinary URL of the doorstep photo.
  ///   - `podSignatureUrl`    - Cloudinary URL of the recipient's signature (opt-in).
  ///   - `podDeliveryOtp`     - bcrypt hash of the 6-digit OTP the customer
  ///                             shared with the rider; only set when the
  ///                             order's total clears the threshold setting.
  ///   - `podCapturedAt`      - wall-clock the rider hit "Complete delivery".
  podPhotoUrl     String?
  podSignatureUrl String?
  podDeliveryOtp  String?
  podCapturedAt   DateTime?

  // Cancellation
  cancelledAt        DateTime?
  cancelledBy        String? // customer, merchant, rider, system
  cancellationReason String?

  // Timestamps for lifecycle
  acceptedAt      DateTime?
  processingAt    DateTime?
  readyAt         DateTime?
  riderAssignedAt DateTime?
  riderEnRouteAt  DateTime?
  pickedUpAt      DateTime?
  inTransitAt     DateTime?
  deliveredAt     DateTime?
  settledAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  items          RequestItem[] // For food/grocery/pharmacy
  packageDetails PackageDetail? // For package delivery
  rating         Rating?

  messages  RequestMessage[]
  disputes  Dispute[]
  offerLogs RiderOfferLog[]

  @@index([customerId])
  @@index([merchantId])
  @@index([riderId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([customerId, status, createdAt(sort: Desc)]) /// Covers the active-request banner: status IN (active set) ORDER BY createdAt DESC LIMIT 1
  @@map("requests")
}

/// RequestMessage - in-app chat between customer/merchant/rider scoped to a request.
model RequestMessage {
  id        String  @id @default(uuid())
  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  fromUserId String
  fromUser   User   @relation(fields: [fromUserId], references: [id], onDelete: Cascade)

  body String @db.VarChar(1000)

  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
  @@index([fromUserId])
  @@map("request_messages")
}

/// RequestItem - Items within a request (food, grocery, pharmacy, retail).
/// `variantId` resolves to the exact SKU bought; `productId` is kept for fallback
/// display when a variant is later deleted. `selectedOptions` is a frozen snapshot
/// of the customer's option-group picks at order time so menu edits don't rewrite history.
model RequestItem {
  id        String  @id @default(uuid())
  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  // Free-form display fields (snapshot of product at order time)
  name        String
  description String?

  // Pricing at time of order - computed server-side, never trusted from client.
  // unitPrice = variant.price + Σ selected option priceDeltas
  unitPrice Decimal @db.Decimal(15, 2)
  quantity  Int     @default(1)
  lineTotal Decimal @db.Decimal(15, 2) /// unitPrice * quantity

  /// Snapshot of option-group selections at order time.
  /// Shape: [{groupId, groupName, items:[{itemId, itemName, priceDelta}]}]
  selectedOptions Json?

  /// Free-text kitchen instructions ("no onions"). Max 200 chars enforced by validator.
  specialInstructions String?

  /// Grocery-only: per-line substitution preference. Null on lines where the
  /// customer didn't pick one (or for non-grocery merchants where the customer
  /// app doesn't expose the control).
  substitution SubstitutionPreference?

  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([productId])
  @@index([variantId])
  @@map("request_items")
}

/// PackageDetail - For package delivery (no merchant)
model PackageDetail {
  id        String  @id @default(uuid())
  requestId String  @unique
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  description String
  size        String // SMALL, MEDIUM, LARGE
  weight      Float?

  // Contact info at pickup
  senderName  String
  senderPhone String

  // Recipient info
  recipientName  String
  recipientPhone String

  // Special instructions
  instructions String?

  createdAt DateTime @default(now())

  @@map("package_details")
}

/// User sessions for JWT refresh token tracking.
model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  deviceInfo   String? /// Free-form device descriptor (legacy; superseded by deviceName/Model)
  deviceName   String? /// User-set device name, e.g., "Bishir's iPhone"
  deviceModel  String? /// Hardware model, e.g., "iPhone15,2", "Pixel 7 Pro"
  userAgent    String? /// Raw User-Agent header captured at session creation
  ipAddress    String?
  lastUsedAt   DateTime @default(now()) /// Updated on every token refresh
  expiresAt    DateTime
  isRevoked    Boolean  @default(false)

  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("sessions")
}

/// User notification preferences - stored per user, synced across devices.
model NotificationPreferences {
  id              String  @id @default(uuid())
  userId          String  @unique
  pushEnabled     Boolean @default(true)
  orderUpdates    Boolean @default(true)
  promotions      Boolean @default(true)
  walletAlerts    Boolean @default(true)
  emailEnabled    Boolean @default(true)
  emailPromotions Boolean @default(false)
  smsEnabled      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification_preferences")
}

/// Web Push (browser / PWA) subscriptions - one row per browser push endpoint.
/// Native devices use `User.fcmToken` (FCM); web PWAs register a browser
/// PushManager subscription here. Pruned automatically when the push service
/// reports the endpoint as gone (404/410).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String /// client public key (base64url) from the browser subscription
  auth      String /// auth secret (base64url) from the browser subscription
  userAgent String?  @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Notification - in-app notification feed (Notification Center).
/// Created by `notify.service.pushAndSocket` whenever a user-facing event
/// happens: request lifecycle, wallet activity, refunds, etc.
/// `data.route` (free-form path like `/request/abc-123`) is used by the
/// mobile client to deep-link the user to the relevant screen when the row
/// is tapped.
model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  String /// REQUEST_STATUS | WALLET | REFUND | SYSTEM ...
  title String
  body  String @db.VarChar(500)
  data  Json? /// { route?, requestId?, transactionId?, ... }

  requestId     String?
  transactionId String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/// SavedAddress - user's reusable delivery / pickup addresses (Phase 6).
/// `placeId` (Google place id) lets us re-look-up the address text without
/// keeping it stale. Only one address per user can be `isDefault=true`; that
/// constraint is enforced in the service layer rather than via a partial unique
/// index so updates don't fight the constraint mid-transaction.
model SavedAddress {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label     String /// "Home", "Work", or free-form
  address   String /// Human-readable formatted address
  lat       Float
  lng       Float
  placeId   String? /// Google place_id for re-geocoding if needed
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, label])
  @@map("saved_addresses")
}

/// Banner - admin-managed promotional banner for the home screen (Phase 6).
/// `audience` is a free-form JSON predicate evaluated server-side
/// (e.g. `{ "kyc": "VERIFIED" }` or `{ "categorySlug": "food" }`); empty
/// audience = visible to all authenticated users. Banners with `startsAt` in
/// the future or `endsAt` in the past are filtered out of the public feed.
model Banner {
  id       String  @id @default(uuid())
  title    String
  subtitle String?
  imageUrl String
  deepLink String? /// e.g. `/wallet`, `/utility/airtime`, or `iprime://...`
  bgColor  String? /// optional accent colour hint for fallback rendering

  startsAt DateTime?
  endsAt   DateTime?
  audience Json? /// free-form audience predicate
  priority Int       @default(0) /// higher = surfaces first

  isActive  Boolean @default(true)
  createdBy String? /// admin user id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@index([priority])
  @@map("banners")
}

/// External payment-provider webhook event log - for idempotency and audit.
model WebhookEvent {
  id             String    @id @default(uuid())
  provider       String /// "katpay" (or other future providers)
  eventType      String /// e.g., "SUCCESSFUL_TRANSACTION"
  transactionRef String    @unique /// External reference for deduplication
  payload        Json /// Raw webhook payload
  processed      Boolean   @default(false)
  processedAt    DateTime?
  error          String? /// Error message if processing failed

  createdAt DateTime @default(now())

  @@index([provider, eventType])
  @@index([transactionRef])
  @@index([processed])
  @@map("webhook_events")
}

/// Platform-wide settings - admin-managed key/value store.
/// All fee constants, thresholds, and feature flags live here.
model PlatformSetting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String? /// Admin user ID

  @@map("platform_settings")
}

/// Idempotency keys - prevent duplicate mutations on mobile retry.
model IdempotencyKey {
  key              String   @id
  userId           String
  route            String
  requestHash      String
  responseSnapshot Json?
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  @@index([userId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// System-owned wallet for escrow and platform earnings.
model SystemWallet {
  id        String   @id
  name      String
  balance   Decimal  @default(0) @db.Decimal(15, 2)
  updatedAt DateTime @updatedAt

  @@map("system_wallets")
}

/// Audit log - tracks all admin actions for compliance and debugging.
model AuditLog {
  id          String  @id @default(uuid())
  adminUserId String
  action      String /// "APPROVE_MERCHANT", "SUSPEND_USER", etc.
  entityType  String /// "MERCHANT", "USER", "RIDER", "REQUEST", etc.
  entityId    String /// ID of the affected entity
  details     Json? /// Additional context (e.g., reason, old value, new value)
  ipAddress   String?
  userAgent   String?

  createdAt DateTime @default(now())

  @@index([adminUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Append-only compliance log of every BVN verification attempt.
/// Required for AML / KYC audits - regulators ask for "every time a user
/// attempted to bind a BVN to their account, including failures".
/// We store the BVN hash (never plaintext) so we can correlate without leaking.
model BvnVerificationLog {
  id          String                 @id @default(uuid())
  userId      String
  bvnHash     String /// bcrypt hash of the attempted BVN
  outcome     BvnVerificationOutcome
  reason      String? /// Failure reason or recovery context
  providerRef String? /// Provider's reference (Smile ID / Flutterwave) when integrated
  ipAddress   String?
  userAgent   String?
  metadata    Json? /// Additional context (matched fields, scores, etc.)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([outcome])
  @@index([createdAt])
  @@map("bvn_verification_logs")
}

// ============================================================
// SUPPORT - TICKETS, DISPUTES, MESSAGES
// ============================================================

enum TicketCategory {
  ACCOUNT
  PAYMENT
  ORDER
  DELIVERY
  PRODUCT
  TECHNICAL
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_USER
  RESOLVED
  CLOSED
}

enum DisputeCategory {
  ITEM_NOT_RECEIVED
  ITEM_DAMAGED
  WRONG_ITEM
  PARTIAL_DELIVERY
  RIDER_BEHAVIOR
  MERCHANT_BEHAVIOR
  PAYMENT_ISSUE
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  AWAITING_RESPONSE
  RESOLVED
  REJECTED
}

enum DisputeResolution {
  FULL_REFUND
  PARTIAL_REFUND
  REJECTED
  RESOLVED_NO_REFUND
}

/// SupportTicket - generic help/issue thread raised by any user (customer, merchant, rider, admin).
/// Not tied to a specific Request. For order-specific complaints use Dispute.
model SupportTicket {
  id             String         @id @default(uuid())
  number         Int            @default(autoincrement()) /// Human-readable ticket number
  userId         String
  user           User           @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  category       TicketCategory
  priority       TicketPriority @default(MEDIUM)
  status         TicketStatus   @default(OPEN)
  subject        String         @db.VarChar(200)
  description    String         @db.Text
  attachmentUrls String[] /// Cloudinary URLs supplied at creation
  assignedToId   String? /// Admin user id assigned to handle the ticket
  assignedTo     User?          @relation("AssignedTickets", fields: [assignedToId], references: [id])
  resolution     String? /// Free-text resolution summary (no refunds for tickets)
  resolvedAt     DateTime?
  closedAt       DateTime?
  lastActivityAt DateTime       @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportMessage[]

  @@index([userId])
  @@index([status])
  @@index([assignedToId])
  @@index([lastActivityAt])
  @@map("support_tickets")
}

/// Dispute - formal complaint by a customer against a specific Request.
/// Resolving with FULL_REFUND/PARTIAL_REFUND atomically credits the customer's wallet
/// and writes a Transaction(type=REFUND) row inside the same prisma.$transaction.
model Dispute {
  id                  String             @id @default(uuid())
  number              Int                @default(autoincrement())
  requestId           String
  request             Request            @relation(fields: [requestId], references: [id], onDelete: Cascade)
  raisedById          String
  raisedBy            User               @relation("RaisedDisputes", fields: [raisedById], references: [id], onDelete: Cascade)
  category            DisputeCategory
  status              DisputeStatus      @default(OPEN)
  reason              String             @db.VarChar(200)
  description         String             @db.Text
  attachmentUrls      String[]
  resolution          DisputeResolution?
  resolutionNotes     String?
  refundAmount        Decimal?           @db.Decimal(15, 2)
  refundTransactionId String?            @unique
  refundTransaction   Transaction?       @relation("DisputeRefund", fields: [refundTransactionId], references: [id])
  resolvedById        String?
  resolvedBy          User?              @relation("ResolvedDisputes", fields: [resolvedById], references: [id])
  resolvedAt          DateTime?
  lastActivityAt      DateTime           @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportMessage[]

  @@index([requestId])
  @@index([raisedById])
  @@index([status])
  @@index([lastActivityAt])
  @@map("disputes")
}

/// SupportMessage - a single message inside either a SupportTicket or a Dispute thread.
/// Exactly one of ticketId or disputeId is set. `isInternal=true` is admin-only and hidden from
/// non-admin users when serializing the thread.
model SupportMessage {
  id             String         @id @default(uuid())
  ticketId       String?
  ticket         SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  disputeId      String?
  dispute        Dispute?       @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  fromUserId     String
  fromUser       User           @relation(fields: [fromUserId], references: [id], onDelete: Cascade)
  body           String         @db.VarChar(2000)
  attachmentUrls String[]
  isInternal     Boolean        @default(false)
  readAt         DateTime?

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([disputeId])
  @@index([createdAt])
  @@map("support_messages")
}

// ============================================================
// WAITLIST - pre-launch sign-ups from the marketing website.
// ============================================================
// Customers / riders who tap "Download" before the mobile apps are in the
// stores leave their contact info here. Admin can view + export the list.
// No PII enforcement - phone is the only required identifier.

enum WaitlistRole {
  CUSTOMER
  RIDER
  UNKNOWN
}

enum WaitlistPlatform {
  IOS
  ANDROID
  UNKNOWN
}

model WaitlistEntry {
  id        String           @id @default(uuid())
  name      String           @db.VarChar(120)
  phone     String           @db.VarChar(20)
  email     String?          @db.VarChar(160)
  city      String?          @db.VarChar(80)
  notes     String?          @db.VarChar(1000)
  role      WaitlistRole     @default(UNKNOWN)
  platform  WaitlistPlatform @default(UNKNOWN)
  source    String?          @db.VarChar(255) /// Page URL the form was submitted from
  ipAddress String?          @db.VarChar(64)
  userAgent String?          @db.VarChar(500)

  createdAt DateTime @default(now())

  @@index([role])
  @@index([phone])
  @@index([createdAt])
  @@map("waitlist_entries")
}
